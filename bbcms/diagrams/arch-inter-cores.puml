@startuml arch-inter-cores
!theme plain
skinparam componentStyle rectangle

title Cartographie des modules internes de bbcms (application autonome)

package "bbcms — modules transverses" #EEEEEE {
    component [shared\n(BaseEntity, audit,\nDomainEventBus)] as shared
    component [config\n(Configuration globale,\nLiquibase, Minio,\nQuartz scheduler)] as config
}

package "bbcms — Identité & Accès" #E8F5E9 {
    component [authentication\n(JWT issuer,\nlogin / logout,\nrefresh, reset password)] as auth
    component [authorization\n(RBAC interne :\nRole, Permission,\n@Secured filter)] as authz
    component [identity\n(UserAccount,\nMembershipRequest,\nactivation e-mail)] as identity
}

package "bbcms — Domaine fonctionnel" #E8EAF6 {
    component [**bbcms / core**\n(BibleClub, Meeting,\nEvent, Evangelism,\nDiscipleship, Intercession,\nFinance, Publication,\nAttendance/Faithfulness)] as core #7986CB
}

package "bbcms — Services techniques" #E3F2FD {
    component [storage\n(FileStoragePort\n+ MinioAdapter)] as storage
    component [notification\n(NotificationPort\n+ Push / Email / SMS\nadapters)] as notif
    component [settings\n(seuils faithfulness,\nmax photos,\ndurées de cron)] as settings
    component [sync\n(LocalSyncPort\n+ SQLite/Room offline)] as sync
}

' Infrastructures externes (technologies utilisées)
database "PostgreSQL" as pg
cloud "MinIO / S3" as minio
cloud "Firebase FCM\nAPNS\nSMTP" as pushSmtp
database "SQLite (client)" as sqlite

' Le domaine fonctionnel utilise les modules transverses
core ..> shared : <<extends>>\nBaseEntity, audit
core ..> config : <<utilise>>\nQuartz scheduler

' Sécurité : filtre transparent appliqué aux contrôleurs
core ..> auth : <<implicite>>\nJWT validé via filtre
core ..> authz : <<@Secured("bbcms:...")>>\nvérification transparente
core --> identity : utilise UserAccount\npour rattacher Member

' Le domaine appelle les ports techniques
core --> storage : <<port/out>>\nstockage photos,\nattestations,\nimages publications
core --> notif : <<port/out>>\npush meeting,\nrappels événements,\ndaily verse
core --> settings : <<port/out>>\nlecture des seuils\net paramètres
core --> sync : <<port/out>>\nréplication offline

' Adaptateurs vers infrastructures
storage --> minio : S3 SDK
notif --> pushSmtp : FCM / SMTP / Twilio
core --> pg : R2DBC
sync --> sqlite : Room / SQLite JDBC

' Bus d'événements interne (Spring ApplicationEvent)
note right of shared
  Communication asynchrone
  **interne** via DomainEventBus
  (Spring ApplicationEvent),
  pas de broker externe.

  Événements typiques :
  • MEMBER_ADDED
  • MEETING_PLANNED
  • MEETING_RECORDED
  • EVENT_PLANNED
  • EVANGELISM_RECORDED
  • FAITHFULNESS_COMPUTED
  • BBC_RESET
end note

@enduml
