@startuml deploy-bbcms
!theme plain
skinparam nodeStyle rectangle

title Diagramme de déploiement — bbcms (application autonome)

node "Client mobile" as clientMobile {
    component [App Android / iOS\n(Flutter / React Native)] as mobileApp
    database "SQLite local\n(Room)\nvue propriétaire" as sqlite
    mobileApp -down-> sqlite : R/W offline
}

node "Client Desktop" as clientDesktop {
    component [App Desktop\n(Electron / .NET)] as desktopApp
    database "SQLite local\n(données du leader)" as sqliteD
    desktopApp -down-> sqliteD : R/W offline
}

node "Client Web" as clientWeb {
    component [Navigateur\n(Angular / React)] as browser
}

node "Reverse Proxy" as lb {
    component [Nginx / Traefik\n(HTTPS, WebSocket)] as proxy
}

node "Application Server" as appServer {
    node "JVM — Spring Boot (WebFlux)" as jvm {
        component [bbcms — adapter/in/web\n(REST controllers)] as adapterWeb
        component [bbcms — adapter/in/mobile\n(Sync REST + WebSocket)] as adapterMobile
        component [bbcms — adapter/in/scheduler\n(Quartz : faithfulness,\ninactivité, reset annuel)] as adapterSched

        component [bbcms — application/service\n(use cases : auth, BBC,\nmeeting, event, evangelism,\ndiscipleship, intercession,\nfinance, publication)] as appLayer

        component [bbcms — domain] as domLayer

        component [bbcms — security\n(JWT issuer, SecurityFilter,\nRBAC, password hashing)] as secLayer

        component [bbcms — adapter/out/persistence\n(R2DBC + SQLite mappers)] as persistLayer

        component [bbcms — adapter/out/storage\n(MinioFileStorageAdapter)] as storageLayer

        component [bbcms — adapter/out/notification\n(FCM / APNS / SMTP / Twilio)] as notifLayer

        component [bbcms — shared\n(BaseEntity, audit,\nDomainEventBus)] as sharedLayer
    }
}

database "PostgreSQL" as pg {
    storage "Schéma bbcms\n(bbcms_user_account,\nbbcms_bible_club,\nbbcms_meeting, …)" as bbcmsSchema
    storage "Schéma audit\n(audit_log,\ndomain_event)" as auditSchema
}

database "MinIO / S3" as minio {
    storage "Bucket: bbcms-media\n(photos meeting,\nphotos events,\nattestations,\nimages daily verse)" as bucket
}

node "Push & E-mail providers" as pushSvc {
    component [Firebase FCM / APNS] as fcm
    component [SMTP (Sendgrid)] as smtp
    component [SMS gateway\n(Twilio / Orange API)] as sms
}

mobileApp -down-> proxy : HTTPS / WSS
desktopApp -down-> proxy : HTTPS / WSS
browser -down-> proxy : HTTPS

proxy -down-> adapterWeb : HTTP (reverse proxy)
proxy -down-> adapterMobile : WSS

adapterWeb --> secLayer : SecurityFilter (JWT)
adapterMobile --> secLayer : SecurityFilter (JWT)
adapterWeb --> appLayer
adapterMobile --> appLayer
adapterSched --> appLayer
appLayer --> domLayer
appLayer --> persistLayer
appLayer --> storageLayer
appLayer --> notifLayer
appLayer --> sharedLayer

persistLayer -down-> pg : R2DBC
storageLayer -down-> minio : S3 SDK
notifLayer -down-> fcm : push
notifLayer -down-> smtp : e-mail
notifLayer -down-> sms : SMS

note right of jvm
  bbcms est packagé en **un seul jar**
  Spring Boot. Tous les modules
  (authentication, authorization,
  identity, storage, notification,
  settings) sont des **packages internes**
  de l'application — il n'y a aucune
  dépendance vers un autre micro-service.
end note

@enduml
