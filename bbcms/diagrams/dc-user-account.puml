@startuml dc-user-account
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "bbcms / shared" #EEEEEE {
    abstract class BaseEntity {
        # id : UUID
        # createdBy : UUID
        # createdAt : Instant
        # updatedBy : UUID
        # updatedAt : Instant
        # version : Long
    }

    class PasswordResetToken <<Value Object>> {
        - token : String
        - expiresAt : Instant
        - used : boolean
    }

    class ActivationToken <<Value Object>> {
        - token : String
        - expiresAt : Instant
        - used : boolean
    }
}

package "bbcms / domain — Comptes & Inscriptions" #F5F5FF {

    class UserAccount extends BaseEntity {
        - email : String
        - passwordHash : String
        - phone : String
        - status : AccountStatus
        - userType : UserType
        - lastLoginAt : Instant
        - locale : String
        + activate() : void
        + deactivate() : void
        + updateProfile(...) : void
        + changePassword(old, new) : void
        + verifyPassword(plain) : boolean
    }

    class Role extends BaseEntity {
        - name : String
        - description : String
        - permissions : Set<Permission>
        + grant(p : Permission) : void
        + revoke(p : Permission) : void
    }

    class Permission <<Value Object>> {
        - code : String
        - description : String
    }

    class UserAccountRoleAssignment extends BaseEntity {
        - userAccountId : UUID
        - roleId : UUID
        - scopeBibleClubId : UUID
        - active : boolean
        + revoke() : void
    }

    class MembershipRequest extends BaseEntity {
        - userAccountId : UUID
        - requestedType : UserType
        - bibleClubId : UUID
        - levelId : UUID
        - profession : String
        - status : MembershipRequestStatus
        - decisionBy : UUID
        - decisionAt : Instant
        - decisionComment : String
        + approve(by, bbcId, levelId) : void
        + reject(by, reason) : void
        + cancel() : void
    }

    class UserProfile <<Value Object>> {
        - firstNames : String
        - nextNames : String
        - dateOfBirth : LocalDate
        - gender : Gender
        - dateBornAgain : LocalDate
        - howBornAgain : String
        - dateEntered : LocalDate
        - pictureFileId : UUID
    }

    enum AccountStatus {
        PENDING
        ACTIVE
        SUSPENDED
        REMOVED
    }

    enum UserType {
        VISITOR
        STUDENT
        PROFESSIONAL
        NATIONAL_LEADER
    }

    enum MembershipRequestStatus {
        PENDING
        APPROVED
        REJECTED
        CANCELLED
    }

    enum Gender {
        MALE
        FEMALE
    }

    UserAccount *-- "1" UserProfile
    UserAccount o-- "0..*" MembershipRequest
    UserAccount o-- "0..*" UserAccountRoleAssignment
    UserAccount o-- "0..*" PasswordResetToken
    UserAccount o-- "0..1" ActivationToken
    Role *-- "0..*" Permission
    UserAccountRoleAssignment --> Role
    UserAccount --> AccountStatus
    UserAccount --> UserType
    MembershipRequest --> MembershipRequestStatus
    UserProfile --> Gender
}

@enduml
