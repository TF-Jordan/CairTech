@startuml arch-hexagonal
!theme plain
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

title Architecture Hexagonale — bbcms (application autonome)

package "bbcms" #F0F0FF {

    package "domain/" #FFFFDD {
        component [BibleClub\nLevel\nMember\nNationalLeader\nProfessional\nMentor\nMeeting\nEvent\nAttendance\nEvangelismProgram\nEvangelismRecord\nDiscipleshipRecord\nPrayerChain\nFinancialContribution\nDailyVerse] as domain
        note bottom of domain
            Agrégats, Value Objects,
            Événements domaine,
            Règles métier pures
            (aucune dépendance technique)
        end note
    }

    package "application/" #DDFFDD {
        interface "<<port/in>>\nAuthenticationUseCase\nManageUserAccountUseCase\nManageRoleUseCase\nManageBibleClubUseCase\nManageMembershipUseCase\nManageMeetingUseCase\nManageEventUseCase\nRecordAttendanceUseCase\nManageEvangelismUseCase\nManageDiscipleshipUseCase\nManageIntercessionUseCase\nManageFinancialContribUseCase\nPublishDailyVerseUseCase\nResetBibleClubUseCase\nComputeFaithfulnessUseCase" as portIn

        component [AuthenticationService\nUserAccountService\nRoleService\nBibleClubService\nMembershipService\nMeetingService\nEventService\nAttendanceService\nFaithfulnessEngine\nEvangelismService\nDiscipleshipService\nIntercessionService\nFinancialContribService\nPublicationService\nResetService] as services

        interface "<<port/out>>\nUserAccountRepository\nRoleRepository\nBibleClubRepository\nMemberRepository\nMeetingRepository\nEventRepository\nAttendanceRepository\nEvangelismRepository\nDiscipleshipRepository\nFinancialContribRepository\nFileStoragePort\nNotificationPort\nSettingsPort\nLocalSyncPort" as portOut
    }

    package "adapter/in/" #DDDDFF {
        component [WebController\n(Spring WebFlux)\nDTO / Mapper] as adapterInWeb
        component [SecurityFilter\n(JWT, RBAC interne)] as secFilter
        component [MobileSyncController\n(REST + WebSocket)] as adapterInMobile
        component [Scheduler\n(@Scheduled / Quartz)] as adapterInSched
    }

    package "adapter/out/" #FFDDDD {
        component [R2DBC Repositories\n(persistence — online DB)] as adapterOutPersist
        component [SQLite/Room Repositories\n(persistence — offline cache)] as adapterOutLocal
        component [MinioFileStorageAdapter\n(implémente FileStoragePort)] as adapterOutFile
        component [PushNotificationAdapter (FCM/APNS)\nEmailNotificationAdapter (SMTP)\nSmsNotificationAdapter] as adapterOutNotif
        component [InAppSettingsAdapter\n(propriétés + table bbcms_setting)] as adapterOutSettings
    }

    package "shared/" #F0F0F0 {
        component [BaseEntity\nAuditTrail\nMultiTenantSupport\nDomainEventBus\nApiErrorResponse\nPagedResponse] as shared
    }

    package "config/" #F0F0F0 {
        component [BbcmsConfiguration\nSecurityConfiguration\nLiquibaseConfig\nMinioConfig\nNotificationConfig] as config
    }
}

' Flux internes
secFilter -down-> adapterInWeb : injecte SecurityContext
adapterInWeb -down-> portIn : implémente
adapterInMobile -down-> portIn : implémente
adapterInSched -down-> portIn : déclenche
portIn -down-> services : orchestre
services -down-> domain : utilise
services -down-> portOut : appelle
portOut -down-> adapterOutPersist : implémenté par
portOut -down-> adapterOutLocal : implémenté par
portOut -down-> adapterOutFile : implémenté par
portOut -down-> adapterOutNotif : implémenté par
portOut -down-> adapterOutSettings : implémenté par

domain .right.> shared : <<extends BaseEntity>>
adapterInWeb .right.> shared : <<PagedResponse>>\n<<ApiErrorResponse>>

' Infrastructures externes (technologies)
database "PostgreSQL\n(schéma bbcms)" as pg
database "SQLite\n(client mobile/desktop)" as sqlite
cloud "MinIO / S3\n(bucket bbcms-media)" as minio
cloud "Firebase FCM / APNS" as fcm
cloud "SMTP" as smtp

adapterOutPersist -down-> pg : R2DBC
adapterOutLocal -down-> sqlite : Room / SQLite JDBC
adapterOutFile -down-> minio : S3 SDK
adapterOutNotif -down-> fcm : push
adapterOutNotif -down-> smtp : e-mail

@enduml
