@startuml ds-bbcms-06-faithfulness-compute
!theme plain
skinparam sequenceArrowThickness 1.5

title DS-BBCMS-06 — Calcul périodique de la fidélité (cron) et désinscription des absents

participant "FaithfulnessScheduler\n<<adapter/in>>\n@Scheduled(cron='0 0 2 * * *')" as sched
participant "FaithfulnessEngine" as engine
participant "AttendanceService" as svcAtt
participant "MembershipService" as svcMem
participant "SettingsPort\n<<port/out>>" as settings
participant "MemberRepository" as repoMem
participant "AttendanceRepository" as repoAtt
participant "MeetingRepository" as repoMeet
participant "InactivityWatchRepository" as repoIw
participant "NotificationPort" as notifPort
database "PostgreSQL" as db
participant "DomainEventBus" as outbox

sched -> svcAtt : computeFaithfulnessForAll()
activate svcAtt

svcAtt -> settings : getFaithfulnessRules()
activate settings
settings --> svcAtt : Rules {\n  faithfulThresholdPct = 50,\n  inactivityDaysThreshold = 90\n}
deactivate settings

svcAtt -> repoMem : findAllActiveStudents()
repoMem --> svcAtt : Flux<Student>

loop pour chaque student
    svcAtt -> repoMeet : countEligibleMeetings(\n  student, currentAcademicYear)
    repoMeet --> svcAtt : totalEligible

    svcAtt -> repoAtt : findOrInit(studentId, year)
    repoAtt --> svcAtt : AttendanceScore

    svcAtt -> engine : recompute(score, totalEligible, threshold)
    activate engine
    note right of engine
      P% = score / totalEligible × 100
      faithful = (P% >= 50)
      Le score est incrémenté par DS-BBCMS-03
      lors de la saisie de présence.
    end note
    engine --> svcAtt : updated AttendanceScore
    deactivate engine

    svcAtt -> repoAtt : save(score)
end

svcAtt -> outbox : publishDomainEvent(FAITHFULNESS_COMPUTED,\n  {computedAt, nbStudents})
deactivate svcAtt

== Désinscription automatique des inactifs ==

sched -> svcMem : removeInactiveMembers()
activate svcMem
svcMem -> repoIw : findAllStale(threshold)
repoIw --> svcMem : List<InactivityWatch>

loop pour chaque inactivité
    svcMem -> svcMem : iw.removeIfStale(now)\n→ true / false

    alt removed
        svcMem -> repoMem : updateStatus(memberId, REMOVED)
        repoMem -> db : UPDATE bbcms_member SET status='REMOVED'

        svcMem -> notifPort : notifyMemberAndLeader(\n  memberId, "Désinscription pour inactivité")

        svcMem -> outbox : publishDomainEvent(MEMBER_REMOVED_INACTIVITY,\n  {memberId, lastSeenAt})
    end
end
deactivate svcMem

@enduml
